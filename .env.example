# Copia este archivo como .env y complétalo. El .env NUNCA se sube a git.

# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True solo en desarrollo. En producción déjalo en False.
DJANGO_DEBUG=False
# Dominios permitidos separados por coma (en producción es obligatorio).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

DB_NAME=Proyecto
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Gmail: usa una "contraseña de aplicación" (https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

FRONTEND_URL=http://localhost:4200
GOOGLE_CLIENT_ID=
